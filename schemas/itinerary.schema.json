{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "itinerary.schema.json",
  "title": "AI 出行与规划 · 接口契约 v1（修订 v1.2）",
  "description": "PlanResponse 的文档版。给人看，不参与运行时校验 —— 运行时的事实来源是 engine/models.py。",
  "type": "object",
  "required": ["request"],
  "properties": {
    "request": {
      "type": "object",
      "description": "PlanRequest：引擎唯一输入，所有字段都有默认值",
      "properties": {
        "city": { "type": "string", "default": "" },
        "days": { "type": "integer", "minimum": 1, "default": 1 },
        "start_time": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$", "default": "09:00" },
        "end_time": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$", "default": "18:00" },
        "daily_budget": { "type": ["number", "null"], "description": "null 或 <=0 = 不限制预算", "default": null },
        "interests": { "type": "array", "items": { "type": "string" }, "default": [] },
        "avoid": { "type": "array", "items": { "type": "string" }, "default": [] },
        "pace": { "type": "string", "enum": ["relaxed", "normal", "packed"], "default": "normal" },
        "start_poi_id": { "type": ["string", "null"], "default": null },
        "top_n": { "type": "integer", "minimum": 1, "default": 6 },
        "raw_query": { "type": "string", "default": "" },
        "origin": { "type": "string", "default": "", "description": "v1.2 出发地名称，空 = 由策略决定起点" },
        "date": { "type": "string", "default": "", "description": "v1.2 YYYY-MM-DD，空 = 今天" },
        "travelers": { "type": "integer", "minimum": 1, "default": 1, "description": "v1.2 出行人数，仅用于预算换算" },
        "budget_basis": { "type": "string", "enum": ["per_person", "group"], "default": "per_person", "description": "v1.2 daily_budget 的口径" },
        "must_visit": { "type": "array", "items": { "type": "string" }, "default": [], "description": "v1.2 必去点，软约束" },
        "mobility": { "type": "string", "enum": ["walk", "transit", "drive"], "default": "walk", "description": "v1.2 出行方式偏好；默认 walk 与接该字段前的行为一致" },
        "seed": { "type": ["integer", "null"], "default": null, "description": "v1.2 随机种子，null = 用策略内置种子" },
        "deadline": { "type": "string", "default": "", "description": "v1.3 HH:MM，该时刻前必须抵达最后一个途经点（无途经点则末站）" },
        "waypoints": { "type": "array", "items": { "type": "string" }, "default": [], "description": "v1.3 途经点（名称或 poi_id），按给出顺序强制先后" },
        "profile": { "type": "string", "enum": ["", "save", "fast", "comfort"], "default": "", "description": "v1.3 权重档位，空 = 用场景 [weights]" }
      }
    },
    "days": {
      "type": "array",
      "description": "DayPlan 列表",
      "items": {
        "type": "object",
        "properties": {
          "day_index": { "type": "integer", "minimum": 1, "default": 1 },
          "items": { "type": "array", "items": { "$ref": "#/definitions/ItineraryItem" } },
          "total_cost": { "type": "number" },
          "total_stay_min": { "type": "integer" },
          "total_travel_min": { "type": "number" },
          "total_distance_km": { "type": "number" },
          "date": { "type": "string", "description": "v1.2 YYYY-MM-DD" },
          "weather": { "type": "string", "description": "v1.2 天气摘要" },
          "theme": { "type": "string", "description": "v1.2 当天主题" }
        }
      }
    },
    "warnings": {
      "type": "array",
      "description": "人类可读的降级/违规说明。硬约束违规只写这里，绝不抛异常。",
      "items": { "type": "string" }
    },
    "metrics": {
      "type": "object",
      "description": "四维指标，全部 0~1，越大越好",
      "properties": {
        "satisfaction": { "type": "number", "minimum": 0, "maximum": 1 },
        "cost": { "type": "number", "minimum": 0, "maximum": 1 },
        "time": { "type": "number", "minimum": 0, "maximum": 1 },
        "distance": { "type": "number", "minimum": 0, "maximum": 1 },
        "feasibility": { "type": "number", "minimum": 0, "maximum": 1, "description": "1.0 = 零违规" }
      }
    },
    "strategy": { "type": "string", "description": "使用的算法名，便于复现" },
    "scenario": { "type": "string", "description": "使用的场景配置名" },
    "generated_at": { "type": "string", "description": "ISO 时间字符串" },
    "meta": { "type": "object", "description": "v1.2 自由扩展口袋：数据来源/耗时/降级链留痕。前端不许依赖内部结构" },
    "realtime": { "type": "object", "description": "v1.2 本次使用的实时快照，落盘即可回放" }
  },
  "definitions": {
    "ItineraryItem": {
      "type": "object",
      "required": ["seq", "poi_id", "name"],
      "properties": {
        "seq": { "type": "integer", "minimum": 1 },
        "poi_id": { "type": "string" },
        "name": { "type": "string" },
        "lat": { "type": "number" },
        "lon": { "type": "number" },
        "arrive": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
        "leave": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
        "stay_min": { "type": "integer", "minimum": 0 },
        "cost": { "type": "number", "minimum": 0 },
        "transport": { "$ref": "#/definitions/Transport" },
        "reason": { "type": "string", "description": "可解释性输出：为什么选它/为什么排这时" },
        "category": { "type": "string", "description": "v1.2 分类，前端按类型上色" },
        "address": { "type": "string", "description": "v1.2 地址" },
        "tips": { "type": "string", "description": "v1.2 解说/贴士，可为空" },
        "flags": { "type": "array", "items": { "type": "string" }, "description": "v1.2 风险标记" },
        "url": { "type": "string", "description": "v1.2 详情链接" }
      }
    },
    "Transport": {
      "type": "object",
      "properties": {
        "mode": { "type": "string", "description": "当天第一项固定为 start" },
        "minutes": { "type": "number", "minimum": 0 },
        "distance_km": { "type": "number", "minimum": 0 },
        "cost": { "type": "number", "minimum": 0 }
      }
    }
  }
}
